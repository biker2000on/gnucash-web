# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
nul
.playwright*/
playwright*/
*.png
!public/icons/*.png

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma
*prompt*
test-results/
.omc/
.superpowers/
.gstack/
.worktrees/
data/

# Syncthing conflict copies (working tree is synced across machines)
*sync-conflict*

# One-off repair/backfill scripts — kept locally, not tracked.
# check-docs-coverage.ts, check-schema-drift.ts, db-init-entrypoint.ts, and
# dev-run-db-init.ts stay tracked: CI, the Docker image, and dev db-init depend
# on them.
scripts/*
!scripts/check-docs-coverage.ts
!scripts/check-schema-drift.ts
!scripts/db-init-entrypoint.ts
!scripts/dev-run-db-init.ts
.polly/
